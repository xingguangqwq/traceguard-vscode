{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceguard.dev/schemas/project-config-v1.json",
  "title": "TraceGuard project audit semantics",
  "description": "Project-local Source, Sink, Sanitizer, Propagator, rule and exclusion configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "default": 1 },
    "sources": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/source" } },
    "sinks": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/sink" } },
    "sanitizers": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/sanitizer" } },
    "propagators": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/propagator" } },
    "wrappers": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/wrapper" } },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "severity": { "$ref": "#/$defs/severity" }
            }
          }
        ]
      }
    },
    "severityOverrides": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/severity" }
    },
    "excludePaths": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "$defs": {
    "language": { "enum": ["javascript", "typescript", "java", "python", "php", "csharp", "go"] },
    "languages": {
      "oneOf": [
        { "required": ["language"], "properties": { "language": { "$ref": "#/$defs/language" } } },
        { "required": ["languages"], "properties": { "languages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/language" } } } }
      ]
    },
    "arguments": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
    "modelBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["function"],
      "allOf": [{ "$ref": "#/$defs/languages" }],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "language": { "$ref": "#/$defs/language" },
        "languages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/language" } },
        "function": { "type": "string", "minLength": 1, "maxLength": 300 },
        "module": { "type": "string", "minLength": 1, "maxLength": 500 },
        "qualifiedName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "receiverType": { "type": "string", "minLength": 1, "maxLength": 500 },
        "arguments": { "$ref": "#/$defs/arguments" },
        "restFrom": { "type": "integer", "minimum": 0, "maximum": 63 },
        "returnsTaint": { "type": "boolean" },
        "callForms": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
      }
    },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/modelBase" },
        { "type": "object", "properties": { "kind": { "enum": ["HTTP_INPUT", "PROCESS_INPUT", "FILE_UPLOAD", "EXTERNAL_INPUT"] } } }
      ]
    },
    "sink": {
      "allOf": [
        { "$ref": "#/$defs/modelBase" },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "$ref": "#/$defs/sinkKind" } } }
      ]
    },
    "sanitizer": {
      "allOf": [
        { "$ref": "#/$defs/modelBase" },
        {
          "type": "object",
          "required": ["capability"],
          "properties": {
            "capability": {
              "oneOf": [
                { "$ref": "#/$defs/guardCapability" },
                { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/guardCapability" } }
              ]
            },
            "applicableSinks": { "type": "array", "items": { "$ref": "#/$defs/sinkKind" } }
          }
        }
      ]
    },
    "propagator": { "$ref": "#/$defs/modelBase" },
    "wrapper": {
      "allOf": [
        { "$ref": "#/$defs/modelBase" },
        {
          "type": "object",
          "properties": {
            "role": { "enum": ["source", "sink", "sanitizer", "guard", "propagator", "wrapper"] },
            "kind": { "type": "string" },
            "capability": {
              "oneOf": [
                { "$ref": "#/$defs/guardCapability" },
                { "type": "array", "items": { "$ref": "#/$defs/guardCapability" } }
              ]
            },
            "applicableSinks": { "type": "array", "items": { "$ref": "#/$defs/sinkKind" } }
          }
        }
      ]
    },
    "sinkKind": {
      "enum": ["SQL_QUERY", "COMMAND_EXEC", "DYNAMIC_EXEC", "FILE_ACCESS", "HTTP_REQUEST", "REDIRECT", "RESPONSE_OUTPUT", "DESERIALIZATION", "DIRECTORY_LOOKUP", "SENSITIVE_OPERATION"]
    },
    "guardCapability": {
      "enum": ["INPUT_VALIDATION", "VALIDATE_SCHEME", "VALIDATE_IP", "BLOCK_PRIVATE_IP", "URL_POLICY", "PATH_CANONICALIZATION", "PATH_CONFINEMENT", "OUTPUT_ENCODING", "SQL_PARAMETERIZATION", "SHELL_ESCAPE", "AUTHENTICATION", "AUTHORIZATION", "DESERIALIZATION_ALLOWLIST"]
    },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] }
  }
}
